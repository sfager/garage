@page "/"
@attribute [Authorize]
@using Garage.Application.Fuel
@using Garage.Application.Maintenance
@using Garage.Application.Mileage
@using Garage.Application.ServiceLogging
@using Garage.Domain.Services
@implements IDisposable

<PageTitle>Garage</PageTitle>

@* Wireframe 1a. The reminder cards and the cost/MPG strip arrive with E3 and E5. *@

<VehicleSwitcher />

@if (_loading)
{
    <p class="mono">Loading your garage…</p>
}
else if (Context.Selected is null)
{
    <div class="empty">
        <h4>No vehicles yet</h4>
        <p class="mono">Add a car and we will start tracking its mileage, service and running costs.</p>
        <a class="btn btn-primary" href="/vehicles/add">Add a vehicle</a>
    </div>
}
else
{
    var vehicle = Context.Selected;

    @if (vehicle.PhotoPath is not null)
    {
        <img src="@FileStore.GetUrl(vehicle.PhotoPath)" alt="@vehicle.DisplayName"
             style="height:160px;width:100%;object-fit:cover;border:1px solid var(--color-divider)" />
    }
    else
    {
        <a class="ph" style="height:120px;text-decoration:none" href="@($"/vehicles/{vehicle.Id}/edit")">
            <span class="mono">@vehicle.DisplayName — add a photo</span>
        </a>
    }

    <div class="row-between row-end">
        <div>
            <div class="sec">Odometer</div>
            <div class="big" style="font-size:34px">
                @vehicle.CurrentOdometer.ToString("N0")<span style="font-size:14px"> mi</span>
            </div>
            <div class="mono">as of @vehicle.CurrentOdometerDate.ToString("MMM d, yyyy")</div>
        </div>
        <button type="button" class="btn btn-primary" @onclick="() => _showUpdate = !_showUpdate">
            @(_showUpdate ? "Close" : "Update")
        </button>
    </div>

    @if (_showUpdate)
    {
        <OdometerCard VehicleId="vehicle.Id" Summary="_summary" OnRecorded="OnRecordedAsync" />
    }

    @* Story L-4: an entry left half-finished can be picked back up. *@
    @if (_resumable)
    {
        <div class="card card-accent">
            <div class="card-kicker">Unfinished entry</div>
            <div class="card-title">@Wizard.Draft.Summary</div>
            <div class="mono">Started @Wizard.Draft.StartedUtc.ToLocalTime().ToString("MMM d, HH:mm")</div>
            <div class="row">
                <a class="btn btn-primary flex-1" href="/log">Resume</a>
                <button type="button" class="btn btn-secondary" @onclick="DiscardDraftAsync">Discard</button>
            </div>
        </div>
    }

    <div class="hr"></div>

    @* Wireframe 1a: the overdue item gets a card with its actions; everything else
       due soon is listed underneath. *@
    @foreach (var card in _overdue)
    {
        <ReminderCardView Card="card" OnSnooze="OpenSnooze" OnDismiss="DismissAsync" />
    }

    <div class="stack-tight">
        <div class="sec">Coming up</div>

        @if (_comingUp.Count == 0)
        {
            <p class="mono">
                @(_overdue.Count > 0
                    ? "Nothing else due soon."
                    : "Nothing scheduled.")
                <a href="/service/reminders">Add a reminder</a>
            </p>
        }
        else
        {
            @foreach (var card in _comingUp)
            {
                <a class="li" style="text-decoration:none;color:inherit" href="/service">
                    <span>@card.Item</span>
                    <span class="mono">@card.Projection.RemainingDescription</span>
                </a>
            }
        }
    </div>

    @* Wireframe 1a's foot: this month, cost per mile and average MPG. *@
    @if (_stats is { } stats)
    {
        <div class="hr"></div>
        <div class="grid-3">
            <div>
                <div class="sec">Last 30d</div>
                <div class="big" style="font-size:20px">@stats.SpendLast30Days.ToString("C0")</div>
            </div>
            <div>
                <div class="sec">Cost / mi</div>
                <div class="big" style="font-size:20px">
                    @(stats.CostPerMile is { } cpm ? cpm.ToString("C2") : "—")
                </div>
            </div>
            <div>
                <div class="sec">Avg MPG</div>
                <div class="big" style="font-size:20px">
                    @(stats.AverageMpg is { } mpg ? mpg.ToString("N1") : "—")
                </div>
            </div>
        </div>
    }

    @if (_snoozing is { } target)
    {
        <SnoozeDialog Card="target" OnClose="() => _snoozing = null" OnSnoozed="OnSnoozedAsync" />
    }
}

@code {
    [Inject] private VehicleContext Context { get; set; } = default!;
    [Inject] private IFileStore FileStore { get; set; } = default!;
    [Inject] private MileageService Mileage { get; set; } = default!;
    [Inject] private MaintenanceService Maintenance { get; set; } = default!;
    [Inject] private ServiceLogWizard Wizard { get; set; } = default!;
    [Inject] private FuelService FuelService { get; set; } = default!;

    private bool _resumable;
    private FuelStats? _stats;
    private MileageSummary? _summary;
    private IReadOnlyList<ReminderCard> _overdue = [];
    private IReadOnlyList<ReminderCard> _comingUp = [];
    private ReminderCard? _snoozing;
    private bool _loading = true;
    private bool _showUpdate;

    protected override async Task OnInitializedAsync()
    {
        Context.Changed += OnContextChanged;
        await Context.EnsureLoadedAsync();
        await LoadSummaryAsync();
        _loading = false;
    }

    private async Task OnContextChanged()
    {
        await LoadSummaryAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadSummaryAsync()
    {
        if (Context.Selected is not { } vehicle)
        {
            _summary = null;
            _overdue = [];
            _comingUp = [];
            _stats = null;
            return;
        }

        _summary = await Mileage.GetSummaryAsync(vehicle.Id);

        await Wizard.EnsureLoadedAsync(vehicle.Id);
        _resumable = Wizard.HasResumableDraft;

        var cards = await Maintenance.ListUpcomingAsync(vehicle.Id);
        _overdue = [.. cards.Where(c => c.Band == DueBand.Overdue)];

        // The home screen is a glance, not the full list — three is what fits [1a].
        _comingUp = [.. cards.Where(c => c.Band == DueBand.DueSoon).Take(3)];

        _stats = (await FuelService.GetScreenAsync(vehicle.Id, FuelRange.TwelveMonths)).Stats;
    }

    private void OpenSnooze(ReminderCard card) => _snoozing = card;

    private async Task OnSnoozedAsync()
    {
        _snoozing = null;
        await LoadSummaryAsync();
    }

    private async Task DismissAsync(ReminderCard card)
    {
        await Maintenance.DismissAsync(card.Id);
        await LoadSummaryAsync();
    }

    private async Task DiscardDraftAsync()
    {
        await Wizard.DiscardAsync();
        _resumable = false;
    }

    /// <summary>Story M-1: the new reading has to show everywhere immediately.</summary>
    private async Task OnRecordedAsync()
    {
        await Context.RefreshSelectedAsync();
        await LoadSummaryAsync();
    }

    public void Dispose() => Context.Changed -= OnContextChanged;
}
